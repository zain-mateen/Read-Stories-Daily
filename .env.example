# Copy this file to .env.local for local development, or enter these as
# Environment Variables in cPanel's "Setup Node.js App" screen for
# production. Never commit an actual .env / .env.local file.

# --- Database (from cPanel > MySQL Databases) -----------------------------
# GoDaddy typically prefixes both the DB name and DB user with your cPanel
# username, e.g. "user_readstories" and "user_blogadmin".
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Admin panel (/admin) --------------------------------------------------
# The password you'll type in at /admin/login. Pick a strong, unique value.
ADMIN_PASSWORD=

# A long random string used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Site ------------------------------------------------------------------
# Your production domain, no trailing slash. Used for metadata/canonical URLs.
NEXT_PUBLIC_SITE_URL=https://www.readstoriesdaily.com

# --- Monetag -----------------------------------------------------------
# Paste the exact <script src="..."> URL Monetag's dashboard gives you
# after you add this site and pick an ad format. The ad script only
# renders once this is set, so it's safe to leave blank locally.
NEXT_PUBLIC_MONETAG_SCRIPT_SRC=
# The zone id Monetag gives you alongside the script (if your ad format
# uses one — some formats don't; leave blank if so).
NEXT_PUBLIC_MONETAG_ZONE_ID=
